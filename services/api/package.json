{
  "name": "udhaarkhata-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "wrangler dev --local",
    "db:migrate:local": "wrangler d1 migrations apply udhaarkhata-local --local",
    "db:check:local": "wrangler d1 execute udhaarkhata-local --local --command \"PRAGMA foreign_key_check\"",
    "typecheck": "tsc --noEmit && tsc --noEmit -p test/tsconfig.json",
    "lint": "eslint .",
    "test": "node --test test/*.test.mjs && vitest run",
    "test:coverage": "vitest run --coverage",
    "build": "wrangler deploy --dry-run --outdir .wrangler/build"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.3.3",
    "@cloudflare/workers-types": "^5.20260926.1",
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.0",
    "@vitest/coverage-istanbul": "4.1.11",
    "eslint": "10.11.0",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "4.1.11",
    "wrangler": "^4.0.0"
  },
  "dependencies": {
    "zod": "^4.6.5"
  }
}
